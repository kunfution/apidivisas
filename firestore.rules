rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep exchangeRates and dailyHistory open for read/write so both apps can work seamlessly as requested
    match /exchangeRates/{document} {
      allow read, write: if true;
    }
    
    match /dailyHistory/{document} {
      allow read, write: if true;
    }
    
    // Catch-all default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
